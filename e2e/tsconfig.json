{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@massingviewer/viewport": [
        "../packages/viewport/src/index.ts"
      ],
      "@massingviewer/core": [
        "../packages/core/src/index.ts"
      ]
    },
    "baseUrl": ".",
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "**/*.ts",
    "../playwright.config.ts"
  ]
}
