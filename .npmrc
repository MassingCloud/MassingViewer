# Exact versions everywhere. The @thatopen/three/web-ifc tuple is version-coupled (see
# scripts/check-fragments-version.mjs); a caret on any one of them is how that coupling breaks
# silently, so the discipline is repo-wide rather than per-dependency.
save-exact=true

# Make the Node-version failure loud at install time, not at build time.
engine-strict=true

# Publish with npm provenance (requires OIDC in CI; ignored locally).
provenance=true

audit-level=high
fund=false
