{
  "name": "massingviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone IFC-native 3D/2D CAD studio for the browser \u2014 view and author models, generate and mark up plans. Offline-capable local kernel, pluggable remote kernel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MassingCloud/MassingViewer.git"
  },
  "homepage": "https://github.com/MassingCloud/MassingViewer#readme",
  "bugs": "https://github.com/MassingCloud/MassingViewer/issues",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.8.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "npm run dev --workspace @massingviewer/demo",
    "build": "tsc --build",
    "clean": "tsc --build --clean && rimraf packages/*/dist apps/*/dist",
    "lint": "eslint . && oxlint",
    "typecheck": "tsc --build --force",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run gates",
    "gates": "npm run gate:arch && npm run gate:license && npm run gate:provenance && npm run gate:docs && npm run gate:versions && npm run gate:fixtures && npm run gate:packaging && npm run gate:recipes && npm run gate:doccode",
    "gate:arch": "node scripts/check-architecture.mjs",
    "gate:license": "node scripts/check-licenses.mjs",
    "gate:provenance": "node scripts/check-provenance.mjs",
    "gate:docs": "node scripts/check-doc-paths.mjs",
    "gate:versions": "node scripts/check-fragments-version.mjs",
    "bench": "node bench/drawing-engines/bakeoff.mjs && node bench/drawing-engines/edge-cases.mjs",
    "gate:fixtures": "node scripts/check-fixtures.mjs",
    "gate:packaging": "node scripts/check-packaging.mjs",
    "gate:recipes": "node scripts/check-recipe-parity.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "node scripts/e2e.mjs --ui",
    "e2e:chromium": "node scripts/e2e.mjs --project=chromium",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "changeset:publish": "npm run build && changeset publish",
    "gate:bundle": "node scripts/bundle-budget.mjs",
    "gate:doccode": "node scripts/check-doc-code.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@ifc-lite/drawing-2d": "1.20.0",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "oxlint": "1.77.0",
    "rimraf": "6.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "eslint": "10.8.0"
  },
  "type": "module"
}
