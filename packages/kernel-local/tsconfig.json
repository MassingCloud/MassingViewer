{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // WebWorker, because this package legitimately contains a Worker entry point — `self`, `MessageEvent` and
    // the `Worker` constructor are its real environment. Note what is *not* here: "DOM". A kernel that could
    // reach `document` would eventually reach it.
    "lib": ["ES2023", "WebWorker"]
  },
  "references": [{ "path": "../core" }, { "path": "../ifc" }, { "path": "../kernel-api" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
