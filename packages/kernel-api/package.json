  "description": "The KernelProvider contract: one interface for authoring IFC, satisfied by an in-browser offline kernel and by a remote authoring service. Types and error taxonomy only, no implementation.",
  "license": "MIT",
  "keywords": ["ifc", "bim", "kernel", "authoring", "aec", "contract"],
  "repository": {
    "type": "git",
