{
  "name": "@massing/plugin-host",
  "version": "0.1.0",
  "description": "Declarative contribution manifests with lazy activation — and a host no plugin can break: quarantine, all-or-nothing activation, and dependency cycles reported as the actual cycle.",
  "license": "MIT",
  "keywords": [
    "plugin",
    "extension",
    "manifest",
    "contribution",
    "aec"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MassingCloud/MassingViewer.git",
    "directory": "packages/plugin-host"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@massing/ui-model": "0.1.0"
  }
}
