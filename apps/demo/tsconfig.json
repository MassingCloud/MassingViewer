{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "types": ["vite/client"]
  },
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/viewport" }, { "path": "../../packages/observability" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
