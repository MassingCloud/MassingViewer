node_modules/
dist/
dist-demo/
coverage/
*.tsbuildinfo
.vitest-cache/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Generated WASM copies — sourced from node_modules by scripts/copy-wasm.mjs
apps/*/public/wasm/

# Local env
.env
.env.local
*.local

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Generated SBOMs. Belt-and-braces: release.yml writes these to RUNNER_TEMP so they cannot be swept into a
# commit by `git add .`, but a local `npm run` should not leave one lying around either.
sbom*.json

# Generated by scripts/build-site.mjs; the Pages artifact, not a source.
site/

# Nightly trend files, written by the perf and frames jobs and uploaded as artifacts.
# Not committed — see perf/README.md for why that is a limitation rather than a preference.
perf/trend.jsonl
perf/frames.jsonl
